{
 "kind": "train",
 "section": "§7.44",
 "ledger_grep": "7.44 波 52",
 "about": "r23（warm-start r22・π 波 52・価値 波 52＋51）の訓練 → 評価帯（波 52 holdout）",
 "job": "train-r23",
 "branch": "claude/train-r23",
 "base": {
  "branch": "claude/cpu-spec-improvements-yw91jd"
 },
 "shards": 1,
 "hours": 5,
 "waves": [
  {
   "branch": "claude/n52-w{ww}",
   "shards": 32,
   "dest": "~/n52",
   "glob": "~/n52/n_records/n52_w*_p[0-3]",
   "expect": 128
  },
  {
   "branch": "claude/n51-w{ww}",
   "shards": 32,
   "dest": "~/n51",
   "glob": "~/n51/n_records/n51_w*_p[0-3]",
   "expect": 128
  }
 ],
 "common_args": [
  "--ablate",
  "rel",
  "--aux-weight",
  "0.1",
  "--lr",
  "2e-4",
  "--epochs",
  "2",
  "--pi-teacher",
  "q_improved",
  "--pi-steps-mult",
  "1.0",
  "--fast",
  "--save-each-epoch",
  "--warm-start",
  "opcg_sim/data/learned/nrel_r22.npz"
 ],
 "runs": [
  {
   "name": "r23",
   "in": [
    "~/n52/n_records/n52_w*_p[0-3]"
   ],
   "z_in": [
    "~/n51/n_records/n51_w*_p[0-3]"
   ],
   "out": "~/nrel_r23.npz",
   "log": "~/train_r23.log"
  }
 ],
 "bands": [
  {
   "in": [
    "~/n52/n_records/n52_w*_p[0-3]"
   ],
   "nrel": [
    "opcg_sim/data/learned/nrel_r13d.npz",
    "opcg_sim/data/learned/nrel_r22.npz",
    "~/nrel_r23.npz",
    "~/nrel_r23.ep0.npz",
    "~/nrel_r23.ep1.npz"
   ],
   "args": [
    "--policy",
    "--holdout-mod",
    "7"
   ],
   "out": "~/band_r23.json",
   "log": "~/band_r23.log"
  }
 ],
 "results_dir": "n1_results",
 "inputs": {
  "warm_start": "opcg_sim/data/learned/nrel_r22.npz"
 },
 "commit_message": "r23 のセット（訓練・評価帯）"
}