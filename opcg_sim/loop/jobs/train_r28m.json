{
 "kind": "train",
 "section": "§7.68",
 "ledger_grep": "7.68 価値の教師に根の推定を混ぜる",
 "about": "r28m（r28 と同じ作り・同じ教材＝warm-start r27・π と価値とも波 58＋59・価値の教師だけ『勝敗と生成役の根の推定の平均』＝--z-mode v0mix）→ 評価帯（波 59 holdout・r28 と同じ帯）",
 "job": "train-r28m",
 "branch": "claude/train-r28m",
 "base": {
  "branch": "claude/value-mix"
 },
 "shards": 1,
 "hours": 5,
 "waves": [
  {
   "branch": "claude/n58-w{ww}",
   "shards": 32,
   "dest": "~/n58",
   "glob": "~/n58/n_records/n58_w*_p[0-3]",
   "expect": 128
  },
  {
   "branch": "claude/n59-w{ww}",
   "shards": 32,
   "dest": "~/n59",
   "glob": "~/n59/n_records/n59_w*_p[0-3]",
   "expect": 128
  }
 ],
 "common_args": [
  "--ablate",
  "rel",
  "--aux-weight",
  "0.1",
  "--lr",
  "2e-4",
  "--epochs",
  "2",
  "--pi-teacher",
  "q_improved",
  "--pi-steps-mult",
  "1.0",
  "--fast",
  "--save-each-epoch",
  "--warm-start",
  "opcg_sim/data/learned/nrel_r27.npz",
  "--z-mode",
  "v0mix"
 ],
 "runs": [
  {
   "name": "r28m",
   "in": [
    "~/n58/n_records/n58_w*_p[0-3]",
    "~/n59/n_records/n59_w*_p[0-3]"
   ],
   "out": "~/nrel_r28m.npz",
   "log": "~/train_r28m.log"
  }
 ],
 "bands": [
  {
   "in": [
    "~/n59/n_records/n59_w*_p[0-3]"
   ],
   "nrel": [
    "opcg_sim/data/learned/nrel_r27.npz",
    "~/nrel_r28m.npz",
    "~/nrel_r28m.ep0.npz",
    "~/nrel_r28m.ep1.npz"
   ],
   "args": [
    "--policy",
    "--holdout-mod",
    "7"
   ],
   "out": "~/band_r28m.json",
   "log": "~/band_r28m.log"
  }
 ],
 "results_dir": "n1_results",
 "inputs": {
  "warm_start": "opcg_sim/data/learned/nrel_r27.npz"
 },
 "commit_message": "r28m のセット（訓練・評価帯）",
 "require": [
  {
   "file": "opcg_sim/learned/train/n_rel_train.py",
   "grep": "v0mix"
  }
 ]
}