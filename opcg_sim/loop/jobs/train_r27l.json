{
 "kind": "train",
 "section": "§7.66",
 "ledger_grep": "7.66 訓練のやり方",
 "about": "r27l（r27 と同じ教材・学習の速さを半分 1e-4・2 周）→ 評価帯（波 57 holdout）",
 "job": "train-r27l",
 "branch": "claude/train-r27l",
 "base": {
  "branch": "claude/cpu-spec-improvements-yw91jd"
 },
 "shards": 1,
 "hours": 5,
 "waves": [
  {
   "branch": "claude/n56-w{ww}",
   "shards": 32,
   "dest": "~/n56",
   "glob": "~/n56/n_records/n56_w*_p[0-3]",
   "expect": 128
  },
  {
   "branch": "claude/n57-w{ww}",
   "shards": 32,
   "dest": "~/n57",
   "glob": "~/n57/n_records/n57_w*_p[0-3]",
   "expect": 128
  }
 ],
 "common_args": [
  "--ablate",
  "rel",
  "--aux-weight",
  "0.1",
  "--lr",
  "1e-4",
  "--epochs",
  "2",
  "--pi-teacher",
  "q_improved",
  "--pi-steps-mult",
  "1.0",
  "--fast",
  "--save-each-epoch",
  "--warm-start",
  "opcg_sim/data/learned/nrel_r26.npz"
 ],
 "runs": [
  {
   "name": "r27l",
   "in": [
    "~/n56/n_records/n56_w*_p[0-3]",
    "~/n57/n_records/n57_w*_p[0-3]"
   ],
   "out": "~/nrel_r27l.npz",
   "log": "~/train_r27l.log"
  }
 ],
 "bands": [
  {
   "in": [
    "~/n57/n_records/n57_w*_p[0-3]"
   ],
   "nrel": [
    "opcg_sim/data/learned/nrel_r26.npz",
    "opcg_sim/data/learned/nrel_r27.npz",
    "~/nrel_r27l.npz",
    "~/nrel_r27l.ep0.npz",
    "~/nrel_r27l.ep1.npz"
   ],
   "args": [
    "--policy",
    "--holdout-mod",
    "7"
   ],
   "out": "~/band_r27l.json",
   "log": "~/band_r27l.log"
  }
 ],
 "results_dir": "n1_results",
 "inputs": {
  "warm_start": "opcg_sim/data/learned/nrel_r26.npz"
 },
 "commit_message": "r27l のセット（訓練・評価帯）"
}