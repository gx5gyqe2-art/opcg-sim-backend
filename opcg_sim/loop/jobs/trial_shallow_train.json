{
 "kind": "train",
 "section": "§7.53",
 "ledger_grep": "7.53 WP `worker-shallow`",
 "about": "試し: 浅い取得から訓練 1 周（試しの生成の 6 局）→ 評価帯",
 "job": "trial-shallow-train",
 "branch": "claude/worker-shallow-trial-train",
 "base": {
  "branch": "claude/cpu-spec-improvements-yw91jd"
 },
 "shards": 1,
