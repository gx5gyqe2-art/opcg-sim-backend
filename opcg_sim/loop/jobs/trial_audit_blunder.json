    "--games",
    "{GAMES}",
    "--seed-base",
    "{SEED}",
    "--out",
    "{OUT}"
   ],
   "with_args": true
  },
  {
   "name": "judge",
   "args": [
    "judge",
    "--k",
    "4",
    "--limit",
    "2",
    "--out",
    "{OUT}"
   ],
   "with_args": true
  },
  {
   "name": "recheck",
   "args": [
    "recheck",
    "--k",
    "4",
    "--out",
    "{OUT}"
   ],
   "with_args": true
  },
  {
   "name": "verify",
   "args": [
    "verify",
    "--k",
    "4",
    "--out",
    "{OUT}"
   ],
   "with_args": true
  },
  {
   "name": "summary",
   "args": [
    "summary",
    "--out",
    "{OUT}"
   ]
  }
 ],
 "games_file": {
  "file": "games.jsonl",
  "seed_key": "seed",
  "void_key": "void"
 },
 "points_file": {
  "file": "points.jsonl"
 },
 "merge": {
  "games_file": "games.jsonl",
  "concat": {
   "games.jsonl": "games.jsonl",
   "points.jsonl": "points.jsonl",
   "recheck.jsonl": "recheck.jsonl",
   "verify.jsonl": "verify.jsonl",
   "window_stability.jsonl": "window_stability.jsonl"
  },
  "summary": [
   "summary",
   "--out",
   "{OUT}"
  ],
  "summary_file": "summary.json"
 },
 "require": [
  {
   "file": "tests/scripts/blunder_audit.py",
   "grep": "def cmd_summary"
  }
 ],
 "inputs": {
  "setting": "§7.41: 両席 r13d・出荷の設定・random × real・審判 r13d／r20（160 回・K＝32）"
 },
