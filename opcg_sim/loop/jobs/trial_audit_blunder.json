{
 "kind": "audit",
 "section": "§7.45",
 "ledger_grep": "7.45 WP `worker-audit`",
 "about": "試し: 大きな損の洗い出し 1 局（判定は 2 点・K＝4）",
 "job": "trial-audit-blunder-w{KK}",
