{
 "kind": "train",
 "section": "§7.56",
 "ledger_grep": "7.56 波 54",
 "about": "r25（warm-start r24・π 波 54・価値 波 54＋53）の訓練 → 評価帯（波 54 holdout）",
 "job": "train-r25",
 "branch": "claude/train-r25",
 "base": {
  "branch": "claude/cpu-spec-improvements-yw91jd"
 },
 "shards": 1,
 "hours": 5,
 "waves": [
  {
   "branch": "claude/n54-w{ww}",
   "shards": 32,
   "dest": "~/n54",
   "glob": "~/n54/n_records/n54_w*_p[0-3]",
   "expect": 128
  },
  {
   "branch": "claude/n53-w{ww}",
   "shards": 32,
   "dest": "~/n53",
   "glob": "~/n53/n_records/n53_w*_p[0-3]",
   "expect": 128
  }
 ],
 "common_args": [
  "--ablate",
  "rel",
  "--aux-weight",
  "0.1",
  "--lr",
  "2e-4",
  "--epochs",
  "2",
  "--pi-teacher",
  "q_improved",
  "--pi-steps-mult",
  "1.0",
  "--fast",
  "--save-each-epoch",
  "--warm-start",
  "opcg_sim/data/learned/nrel_r24.npz"
 ],
 "runs": [
  {
   "name": "r25",
   "in": [
    "~/n54/n_records/n54_w*_p[0-3]"
   ],
   "z_in": [
    "~/n53/n_records/n53_w*_p[0-3]"
   ],
   "out": "~/nrel_r25.npz",
   "log": "~/train_r25.log"
  }
 ],
 "bands": [
  {
   "in": [
    "~/n54/n_records/n54_w*_p[0-3]"
   ],
   "nrel": [
    "opcg_sim/data/learned/nrel_r23.npz",
    "opcg_sim/data/learned/nrel_r24.npz",
    "~/nrel_r25.npz",
    "~/nrel_r25.ep0.npz",
    "~/nrel_r25.ep1.npz"
   ],
   "args": [
    "--policy",
    "--holdout-mod",
    "7"
   ],
   "out": "~/band_r25.json",
   "log": "~/band_r25.log"
  }
 ],
 "results_dir": "n1_results",
 "inputs": {
  "warm_start": "opcg_sim/data/learned/nrel_r24.npz"
 },
 "commit_message": "r25 のセット（訓練・評価帯）"
}