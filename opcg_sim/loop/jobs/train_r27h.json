{
 "kind": "train",
 "section": "§7.65",
 "ledger_grep": "7.65 教材の量",
 "about": "r27h（warm-start r26・π と価値とも波 56 と 57 の前半 16 シャードずつ＝r27 の半分の 260 万行・2 波）→ 評価帯（波 57 holdout・全 32 シャード）",
 "job": "train-r27h",
 "branch": "claude/train-r27h",
 "base": {
  "branch": "claude/cpu-spec-improvements-yw91jd"
 },
 "shards": 1,
 "hours": 5,
 "waves": [
  {
   "branch": "claude/n56-w{ww}",
   "shards": 16,
   "dest": "~/n56",
   "glob": "~/n56/n_records/n56_w*_p[0-3]",
   "expect": 64
  },
  {
   "branch": "claude/n57-w{ww}",
   "shards": 32,
   "dest": "~/n57",
   "glob": "~/n57/n_records/n57_w*_p[0-3]",
   "expect": 128
  }
 ],
 "common_args": [
  "--ablate",
  "rel",
  "--aux-weight",
  "0.1",
  "--lr",
  "2e-4",
  "--epochs",
  "2",
  "--pi-teacher",
  "q_improved",
  "--pi-steps-mult",
  "1.0",
  "--fast",
  "--save-each-epoch",
  "--warm-start",
  "opcg_sim/data/learned/nrel_r26.npz"
 ],
 "runs": [
  {
   "name": "r27h",
   "in": [
    "~/n56/n_records/n56_w*_p[0-3]",
    "~/n57/n_records/n57_w0[1-9]_p[0-3]",
    "~/n57/n_records/n57_w1[0-6]_p[0-3]"
   ],
   "out": "~/nrel_r27h.npz",
   "log": "~/train_r27h.log"
  }
 ],
 "bands": [
  {
   "in": [
    "~/n57/n_records/n57_w*_p[0-3]"
   ],
   "nrel": [
    "opcg_sim/data/learned/nrel_r26.npz",
    "opcg_sim/data/learned/nrel_r27.npz",
    "~/nrel_r27h.npz",
    "~/nrel_r27h.ep0.npz",
    "~/nrel_r27h.ep1.npz"
   ],
   "args": [
    "--policy",
    "--holdout-mod",
    "7"
   ],
   "out": "~/band_r27h.json",
   "log": "~/band_r27h.log"
  }
 ],
 "results_dir": "n1_results",
 "inputs": {
  "warm_start": "opcg_sim/data/learned/nrel_r26.npz"
 },
 "commit_message": "r27h のセット（訓練・評価帯）"
}